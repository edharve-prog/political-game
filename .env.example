# Copy this file to .env (same folder as pyproject.toml) and fill in what you use.
# .env is git-ignored, so the key stays on your machine.

# Anthropic API key from https://console.anthropic.com (only needed for --provider api).
# Alternatively sign in with `ant auth login` and leave this out.
ANTHROPIC_API_KEY=

# Which backend --llm uses: auto, api or claude-code. auto picks the API when a key or
# `ant auth login` profile exists, otherwise your Claude Code sign-in.
HOG_SIM_PROVIDER=auto
