# Copy this file to .env (same folder as pyproject.toml) and fill in what you use.
# .env is git-ignored, so the key stays on your machine.

# Anthropic API key from https://console.anthropic.com. Optional: the game uses your Claude
# Code sign-in by default and only falls back to this key when Claude Code is missing or
# signed out. Alternatively sign in with `ant auth login` and leave this out.
ANTHROPIC_API_KEY=

# How the game reaches a model: claude-code (the default, your Claude subscription), api
# (always the Anthropic API, billed per token) or codex (OpenAI Codex signed in with ChatGPT
# via `codex login`).
HOG_SIM_PROVIDER=claude-code

# Codex only: the model Codex should use. Leave blank for Codex's own default.
HOG_SIM_CODEX_MODEL=
